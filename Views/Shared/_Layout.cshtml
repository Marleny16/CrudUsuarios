<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CRUD Usuarios</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <style>

        /* =========================================
                   CONFIGURACIÓN GENERAL
                   ========================================= */

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: #f1f5f9;
            font-family: "Segoe UI", Arial, sans-serif;
            color: #1e293b;
        }


        /* =========================================
                   BARRA SUPERIOR
                   ========================================= */

        .top-navbar {
            background: linear-gradient(135deg, #0f172a, #1e3a8a);
            min-height: 70px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.20);
        }

        .brand {
            color: white !important;
            text-decoration: none;
            font-size: 1.25rem;
            font-weight: 600;
            transition: 0.3s;
        }

            .brand:hover {
                transform: translateY(-2px);
            }

        .brand-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: rgba(255,255,255,0.15);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
        }


        /* =========================================
                   BOTÓN NUEVO USUARIO
                   ========================================= */

        .btn-new-user {
            border: 1px solid rgba(255,255,255,0.5);
            color: white;
            padding: 9px 16px;
            border-radius: 9px;
            text-decoration: none;
            transition: all 0.25s ease;
        }

            .btn-new-user:hover {
                background: white;
                color: #1e3a8a;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            }


        /* =========================================
                   CONTENEDOR PRINCIPAL
                   ========================================= */

        .main-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 35px 20px 50px 20px;
        }


        /* =========================================
                   TARJETAS
                   ========================================= */

        .card {
            border: none !important;
            border-radius: 16px !important;
            box-shadow: 0 5px 20px rgba(15, 23, 42, 0.08);
            transition: all 0.25s ease;
        }

            .card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 30px rgba(15, 23, 42, 0.12);
            }


        /* =========================================
                   ENCABEZADOS
                   ========================================= */

        .page-title {
            font-size: 2rem;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 5px;
        }

        .page-subtitle {
            color: #64748b;
            margin-bottom: 25px;
        }


        /* =========================================
                   BOTONES
                   ========================================= */

        .btn {
            border-radius: 8px !important;
            transition: all 0.2s ease-in-out;
        }

            .btn:hover {
                transform: translateY(-2px);
            }


        /* =========================================
                   TABLAS
                   ========================================= */

        table {
            border-radius: 12px;
            overflow: hidden;
        }

            table thead {
                background: #0f172a !important;
                color: white !important;
            }

                table thead th {
                    background: #0f172a !important;
                    color: white !important;
                    border: none !important;
                    padding: 14px !important;
                }

            table tbody td {
                padding: 13px !important;
                vertical-align: middle;
            }

            table tbody tr {
                transition: background 0.2s ease;
            }

                table tbody tr:hover {
                    background: #eff6ff !important;
                }


        /* =========================================
                   FORMULARIOS
                   ========================================= */

        .form-control {
            border-radius: 9px;
            border: 1px solid #cbd5e1;
            padding: 10px 12px;
        }

            .form-control:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
            }

        .form-label {
            font-weight: 600;
            color: #334155;
        }


        /* =========================================
                   ALERTAS
                   ========================================= */

        .alert {
            border-radius: 10px;
            border: none;
            animation: fadeIn 0.4s ease;
        }


        /* =========================================
                   PIE DE PÁGINA
                   ========================================= */

        .footer {
            background: white;
            border-top: 1px solid #e2e8f0;
            color: #64748b;
            padding: 22px;
            text-align: center;
            margin-top: 30px;
        }


        /* =========================================
                   ANIMACIÓN
                   ========================================= */

        .content-animation {
            animation: fadeInUp 0.45s ease-in-out;
        }

        @@keyframes fadeInUp {

            from {
                opacity: 0;
                transform: translateY(15px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes fadeIn {

            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }


        /* =========================================
                   DISEÑO PARA CELULAR
                   ========================================= */

        @@media (max-width: 768px) {

            .main-container {
                padding: 25px 12px;
            }

            .page-title {
                font-size: 1.6rem;
            }

            .brand span {
                display: none;
            }

            .btn-new-user {
                padding: 8px 12px;
            }
        }

    </style>
</head>

<body>

    <!-- =========================================
         BARRA DE NAVEGACIÓN
         ========================================= -->

    <nav class="top-navbar">

        <div class="container-fluid px-4">

            <div class="d-flex justify-content-between align-items-center"
                 style="min-height:70px;">

                <!-- LOGO / NOMBRE -->
                <a class="brand d-flex align-items-center gap-3"
                   asp-controller="Usuarios"
                   asp-action="Index">

                    <span class="brand-icon">
                        <i class="bi bi-people-fill"></i>
                    </span>

                    <span>
                        CRUD Usuarios
                    </span>

                </a>


                <!-- BOTÓN NUEVO USUARIO -->
                <a class="btn-new-user"
                   asp-controller="Usuarios"
                   asp-action="Create">

                    <i class="bi bi-person-plus-fill me-1"></i>

                    Nuevo usuario

                </a>

            </div>

        </div>

    </nav>


    <!-- =========================================
         CONTENIDO DE CADA VISTA
         ========================================= -->

    <main class="main-container content-animation">

        @RenderBody()

    </main>


    <!-- =========================================
         PIE DE PÁGINA
         ========================================= -->

    <footer class="footer">

        <div>
            <i class="bi bi-database-fill me-1"></i>

            <strong>CRUD Usuarios</strong>
            · Sistema MVC
        </div>

        <small>
            © @DateTime.Now.Year · Aplicación desarrollada en ASP.NET Core
        </small>

    </footer>


    <!-- Bootstrap JavaScript -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>